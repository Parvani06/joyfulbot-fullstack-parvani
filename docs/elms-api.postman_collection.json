{
  "info": {
    "name": "ELMS API Collection",
    "description": "Enterprise Leave Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response.success) {",
                  "  pm.collectionVariables.set('authToken', response.data.token);",
                  "  pm.test('Login successful', function() { pm.expect(response.success).to.be.true; });",
                  "  pm.test('Token received', function() { pm.expect(response.data.token).to.not.be.empty; });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh.kumar@elms.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login - Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "if (response.success) {",
                  "  pm.collectionVariables.set('authToken', response.data.token);",
                  "  pm.test('Login successful', function() { pm.expect(response.success).to.be.true; });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amit.sharma@elms.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Registration successful', function() { pm.expect(response.success).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@elms.com\",\n  \"password\": \"password123\",\n  \"role\": \"EMPLOYEE\",\n  \"departmentId\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Leave Applications",
      "item": [
        {
          "name": "Apply Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Leave application submitted', function() { pm.expect(response.success).to.be.true; });",
                  "if (response.success) {",
                  "  pm.collectionVariables.set('leaveId', response.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/leave-applications",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveTypeId\": 1,\n  \"startDate\": \"2026-08-01\",\n  \"endDate\": \"2026-08-03\",\n  \"reason\": \"Family vacation\"\n}"
            }
          }
        },
        {
          "name": "Get My Applications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Got my applications', function() { pm.expect(response.success).to.be.true; });",
                  "pm.test('Response is array', function() { pm.expect(response.data).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/leave-applications/my"
          }
        },
        {
          "name": "Get All Applications (Manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Got all applications', function() { pm.expect(response.success).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/leave-applications"
          }
        },
        {
          "name": "Approve Leave (Manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Leave approved', function() { pm.expect(response.success).to.be.true; });",
                  "pm.test('Status is APPROVED', function() { pm.expect(response.data.status).to.equal('APPROVED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/leave-applications/6/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"remarks\": \"Approved by manager\"\n}"
            }
          }
        },
        {
          "name": "Reject Leave (Manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Leave rejected', function() { pm.expect(response.success).to.be.true; });",
                  "pm.test('Status is REJECTED', function() { pm.expect(response.data.status).to.equal('REJECTED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": "{{baseUrl}}/leave-applications/7/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"remarks\": \"Rejected due to project deadline\"\n}"
            }
          }
        },
        {
          "name": "Cancel Leave (Employee)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/leave-applications/8"
          }
        }
      ]
    },
    {
      "name": "Leave Balances",
      "item": [
        {
          "name": "Get My Balances",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Got leave balances', function() { pm.expect(response.success).to.be.true; });",
                  "pm.test('Balances is array', function() { pm.expect(response.data).to.be.an('array'); });",
                  "pm.test('Balance deduction verified', function() { pm.expect(response.data.length).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/leave-balances/my?year=2026",
              "query": [{ "key": "year", "value": "2026" }]
            }
          }
        },
        {
          "name": "Get Balance by User ID (Manager)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/leave-balances/user/2?year=2026",
              "query": [{ "key": "year", "value": "2026" }]
            }
          }
        }
      ]
    },
    {
      "name": "Manager",
      "item": [
        {
          "name": "Get Team Leaves",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/manager/team-leaves?page=0&size=10",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Analytics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Got analytics', function() { pm.expect(response.success).to.be.true; });",
                  "pm.test('Has PENDING count', function() { pm.expect(response.data).to.have.property('PENDING'); });",
                  "pm.test('Has TOTAL count', function() { pm.expect(response.data).to.have.property('TOTAL'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/manager/analytics"
          }
        }
      ]
    },
    {
      "name": "Departments & Leave Types",
      "item": [
        {
          "name": "Get All Departments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/departments"
          }
        },
        {
          "name": "Get All Leave Types",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/leave-types"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Get All Users (Manager)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    }
  ]
}